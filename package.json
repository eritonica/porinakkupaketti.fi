  "main": "index.js",
  "bugs": {
    "url": "https://github.com/Hoosat-Oy/hoosat-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoosat-Oy/hoosat-template"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "move:assets": "cp -R public/. build/public",
    "dev:build:client": "npm run move:assets && webpack --config webpack.client.config.js --mode=development --watch",
    "dev:build:server": "webpack --config webpack.server.config.js --mode=development --watch",
    "dev:run": "nodemon -r dotenv/config --experimental-modules build/server.js",
    "dev": "concurrently \"npm run dev:build:client\" \"npm run dev:build:server\" \"npm run dev:run\"",
    "build:client": "webpack --config webpack.client.config.js --mode=production && npm run move:assets",
    "build:server": "webpack --config webpack.server.config.js --mode=production",
    "build": "concurrently \"npm run build:client\" \"npm run build:server\"",
    "start": "node  -r dotenv/config --experimental-modules build/server.js",
    "deploy": "npm run build && rsync --exclude='.git' --exclude='node_modules' -rPz ./build marko@85.23.193.211:~/porinakkupaketti.fi"
  },
  "experiments": {
    "topLevelAwait": true
  },
  "dependencies": {
    "bson-ext": "^4.0.3",
    "discord.js": "^14.11.0",
    "dotenv": "^16.0.3",
    "google-auth-library": "^8.8.0",
    "i18next-browser-languagedetector": "^7.0.1",
    "i18next-http-backend": "^2.2.0",
    "mongodb-client-encryption": "^2.8.0",
    "mongoose": "^6.11.1",
    "nodemailer": "^6.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-i18next": "^12.2.2",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.11.1",
    "rehype-highlight": "^6.0.0",
    "remark-gfm": "^3.0.1",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.1",
    "@types/node": "^16.11.10",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.4",
    "@types/react-router-dom": "^5.3.3",
    "@types/rss": "^0.0.30",
    "@types/webpack": "^5.28.1",
