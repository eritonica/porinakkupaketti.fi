    "ts-jest": "^29.1.0",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.5.5",
    "webpack": "^5.64.4",
    "webpack-cli": "^5.1.1",
