{
  "type": "module",
  "name": "porinakkupaketti.fi",
  "version": "1.0.0",
  "description": "",
  "author": "Toni Lukkaroinen @ Hoosat Oy",
  "license": "",
  "main": "index.js",
  "bugs": {
    "url": "https://github.com/Hoosat-Oy/hoosat-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoosat-Oy/hoosat-template"
  },
  "scripts": {
    "test": "jest",
    "analyze": "ANALYZE=true webpack --config webpack.client.config.js --mode production",
    "clean:build-dev": "rm -rf build-dev",
    "clean:build-ts": "rm -rf build-ts",
    "clean:build": "rm -rf build",
    "clean": "npm-run-all -p clean:build-ts clean:build-dev clean:build",
    "dev:compress:assets:br": "node --loader ts-node/esm build-tools/compress-files.ts build-dev/public/ br",
    "dev:compress:assets:deflate": "node --loader ts-node/esm build-tools/compress-files.ts build-dev/public/ deflate",
    "dev:compress:assets:gzip": "node --loader ts-node/esm build-tools/compress-files.ts build-dev/public/ gzip",
    "dev:compress:assets": "npm-run-all dev:compress:assets:br dev:compress:assets:deflate dev:compress:assets:gzip",
    "dev:create:build:directories": "npx mkdirp build-dev && npx mkdirp build-dev/public && npx mkdirp build-dev/public/uploads",
    "dev:create:service-worker:urls": "node public/service-worker-urls.js build-dev/public",
    "dev:move:assets": "npx ncp public build-dev/public",
    "dev:move:css": "node --loader ts-node/esm build-tools/extract-css.ts src/client build-dev/public/styles.css",
    "dev:build:client": "webpack --config webpack.client.config.js --mode=development",
    "dev:build:server": "webpack --config webpack.server.config.js --mode=development",
    "dev:prebuild": "npm-run-all dev:create:build:directories dev:move:assets dev:move:css dev:create:service-worker:urls",
    "dev:build": "npm-run-all dev:prebuild dev:build:client dev:build:server dev:compress:assets",
    "dev:start": "nodemon --experimental-modules build-dev/server.js development",
    "dev:watch": "chokidar './src/' './public/' -c 'npm-run-all dev:build'",
    "dev": "npm-run-all clean:build-ts clean:build-dev dev:build -p dev:watch dev:start",
    "compress:assets:br": "node --loader ts-node/esm build-tools/compress-files.ts build/public/ br",
    "compress:assets:deflate": "node --loader ts-node/esm build-tools/compress-files.ts build/public/ deflate",
    "compress:assets:gzip": "node --loader ts-node/esm build-tools/compress-files.ts build/public/ gzip",
    "compress:assets": "npm-run-all compress:assets:br compress:assets:deflate compress:assets:gzip",
    "create:build:directories": "npx mkdirp build && npx mkdirp build/public && npx mkdirp build/public/uploads",
    "create:service-worker:urls": "node public/service-worker-urls.js build/public",
    "move:assets": "npx ncp public build/public",
    "move:css": "node --loader ts-node/esm build-tools/extract-css.ts src/client build/public/styles.css",
    "build:client": "webpack --config webpack.client.config.js --mode=production",
    "build:server": "webpack --config webpack.server.config.js --mode=production",
    "prebuild": "npm-run-all clean:build-ts clean:build create:build:directories move:assets move:css create:service-worker:urls ",
    "build": "npm-run-all prebuild build:client build:server compress:assets",
    "deploy": "npm-run-all build rsync clean:build clean:build-ts",
    "production:start": "node --experimental-modules build/server.js",
    "start": "npm run production:start",
    "rsync": "rsync -rPz --delete --exclude='./build/public/uploads' ./build ./package.json  ./ marko@mthtek.net:~/porinakkupaketti.fi"
  },
  "experiments": {
    "topLevelAwait": true
  },
  "dependencies": {
    "@apollo/react-ssr": "^4.0.0",
    "bson-ext": "^4.0.3",
    "discord.js": "^14.11.0",
    "dotenv": "^16.0.3",
    "formidable": "^3.5.0",
    "google-auth-library": "^8.8.0",
    "i18next-browser-languagedetector": "^7.0.1",
    "i18next-fs-backend": "^2.3.1",
    "i18next-http-backend": "^2.2.0",
    "i18next-node-fs-backend": "^2.1.3",
    "iltorb": "^2.4.5",
    "mongodb-client-encryption": "^2.8.0",
    "mongoose": "^6.11.1",
    "nodemailer": "^6.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-i18next": "^12.2.2",
    "react-lottie-player": "^1.5.4",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.11.1",
    "react-safety-helmet": "^6.3.0",
    "rehype-highlight": "^6.0.0",
    "remark-gfm": "^3.0.1",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/formidable": "^3.4.0",
    "@types/jest": "^29.5.1",
    "@types/node": "^16.11.10",
    "@types/nodemailer": "^6.4.8",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.4",
    "@types/react-router-dom": "^5.3.3",
    "@types/rss": "^0.0.30",
    "@types/uuid": "^9.0.2",
    "@types/webpack": "^5.28.1",
    "compression-webpack-plugin": "^10.0.0",
    "concurrently": "^8.0.1",
    "css-loader": "^6.7.3",
    "esm": "^3.2.25",
    "file-loader": "^6.2.0",
    "jest": "^29.5.0",
    "json-loader": "^0.5.7",
    "mini-css-extract-plugin": "^2.7.6",
    "node-loader": "^2.0.0",
    "nodemon": "^2.0.15",
    "style-loader": "^3.3.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.5.5",
    "webpack": "^5.64.4",
    "webpack-cli": "^5.1.1",
    "webpack-node-externals": "^3.0.0"
  },
  "keywords": [
    "react",
    "SSR",
    "stack",
    "create"
  ]
}
